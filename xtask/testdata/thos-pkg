#!/busybox sh
# thos-pkg: install programs from a file or URL into /opt/<name> and put them in the Start menu.
#   thos-pkg install <file-or-url> [name]     .deb .rpm .zip .tar.gz/.tgz/.tar.xz/.tar.bz2 .exe
#   thos-pkg list
#   thos-pkg remove <name>
#   thos-pkg update                           fetch the Debian package index (needs the network)
#   thos-pkg search <word>                    look a package up in the index
#   thos-pkg install <name>                   a package from the Debian archive, with the libraries it needs
#   thos-pkg installed                        what came from the archive (they share /opt/root)
# Programs are unpacked as they are: libraries they need beyond what THOS ships must be in the package itself.
# Start-menu entries live in /opt/apps.conf ("Label|command"); the panel picks them up when it starts.
OPT=/opt
APPS=$OPT/apps.conf
B=/busybox
ELF=$($B printf '\177ELF')
die() { echo "thos-pkg: $*" >&2; exit 1; }

# label|command lines for what was unpacked into $1 (name $2)
register() {
    dir=$1 name=$2
    libs="$dir/usr/lib:$dir/usr/lib/x86_64-linux-gnu:$dir/lib:$dir/lib/x86_64-linux-gnu:$dir/lib64"
    n=0
    # 1. proper desktop entries
    for d in "$dir"/usr/share/applications/*.desktop; do
        [ -f "$d" ] || continue
        label=$($B sed -n 's/^Name=//p' "$d" | $B head -n 1)
        exe=$($B sed -n 's/^Exec=//p' "$d" | $B head -n 1 | $B sed 's/ *%[a-zA-Z]//g')
        prog=${exe%% *}
        rest=${exe#"$prog"}
        [ "$rest" = "$exe" ] && rest=
        base=${prog##*/}
        for cand in "$dir/usr/bin/$base" "$dir/bin/$base" "$dir/usr/games/$base" "$dir$prog"; do
            if [ -f "$cand" ]; then
                echo "${label:-$base}|LD_LIBRARY_PATH=$libs $cand$rest" >> $APPS
                n=$((n+1)); break
            fi
        done
    done
    [ $n -gt 0 ] && return
    # 2. otherwise: the executables in bin directories (at most five), then loose executables in the top directory
    for d in "$dir/usr/bin" "$dir/bin" "$dir/usr/games" "$dir"; do
        [ -d "$d" ] || continue
        for f in "$d"/*; do
            [ -f "$f" ] || continue
            case "$f" in *.so|*.so.*|*.txt|*.md|*.html|*.conf|*.json|*.png|*.dll) continue ;; esac
            if [ "$($B head -c4 "$f")" = "$ELF" ]; then $B chmod +x "$f"; fi     # unzip does not keep the mode
            if [ -x "$f" ] || [ "${f##*.}" = exe ]; then
                echo "${f##*/}|LD_LIBRARY_PATH=$libs $f" >> $APPS
                n=$((n+1))
                [ $n -ge 5 ] && return
            fi
        done
        [ $n -gt 0 ] && return
    done
    [ $n -gt 0 ] || echo "thos-pkg: no program found to put in the Start menu (files are in $dir)"
}

cmd_install() {
    src=$1
    [ -n "$src" ] || die "install what? (a file, an http/https URL or a Debian package name)"
    case "$src" in
        */*|*.deb|*.rpm|*.zip|*.tar.*|*.tgz|*.exe|*.msi|*.txz) ;;
        *) FIRST=$src; cmd_install_repo "$src"; return $? ;;
    esac
    $B mkdir -p $OPT || die "cannot create $OPT"
    tmp=
    case "$src" in
        http://*|https://*|ftp://*)
            tmp=/tmp/thos-pkg.$$
            echo "downloading $src"
            $B wget -q -O $tmp "$src" || { $B rm -f $tmp; die "download failed"; }
            file=$tmp; base=${src##*/}; base=${base%%\?*} ;;
        *) [ -f "$src" ] || die "no such file: $src"
           file=$src; base=${src##*/} ;;
    esac
    name=$2
    if [ -z "$name" ]; then
        name=${base%.deb}; name=${name%.rpm}; name=${name%.zip}; name=${name%.tar.gz}; name=${name%.tgz}
        name=${name%.tar.xz}; name=${name%.txz}; name=${name%.tar.bz2}; name=${name%.exe}
        name=${name%%_*}
    fi
    [ -n "$name" ] || die "cannot derive a name, give one"
    case "$name" in */*|.*) die "bad name: $name" ;; esac
    dir=$OPT/$name
    [ -e "$dir" ] && die "$name is already installed (thos-pkg remove $name)"
    $B mkdir -p "$dir"
    case "$base" in
        *.deb) $B dpkg-deb -x "$file" "$dir" ;;
        *.rpm) ( cd "$dir" && $B rpm2cpio "$file" | $B cpio -idm 2>/dev/null ) ;;
        *.zip) $B unzip -q -o "$file" -d "$dir" ;;
        *.tar.gz|*.tgz) $B zcat "$file" | $B tar -x -C "$dir" ;;
        *.tar.xz|*.txz) $B xzcat "$file" | $B tar -x -C "$dir" ;;
        *.tar.bz2) $B bzcat "$file" | $B tar -x -C "$dir" ;;
        *.tar) $B tar -xf "$file" -C "$dir" ;;
        *.exe) $B cp "$file" "$dir/$base"; $B chmod +x "$dir/$base" ;;
        *.msi) $B rm -rf "$dir"; [ -n "$tmp" ] && $B rm -f $tmp; die "Windows Installer packages (.msi) are not supported yet" ;;
        *) $B rm -rf "$dir"; [ -n "$tmp" ] && $B rm -f $tmp; die "unknown package type: $base" ;;
    esac
    status=$?
    [ -n "$tmp" ] && $B rm -f $tmp
    if [ $status -ne 0 ]; then $B rm -rf "$dir"; die "unpacking failed"; fi
    register "$dir" "$name"
    echo "installed $name in $dir"
}

# ---- the Debian archive ----
MIRROR=http://deb.debian.org/debian
INDEX_URL=http://deb.debian.org/debian/dists/trixie/main/binary-amd64/Packages.xz
IDX=$OPT/.index
DB=$OPT/.db
ROOT=$OPT/root
# packages THOS already provides (the C library and friends) or that are only installer plumbing
SKIP=" libc6 libc-bin libgcc-s1 gcc-14-base libstdc++6 debconf dpkg perl-base base-files base-passwd install-info libcrypt1 libgomp1 "

cmd_update() {
    $B mkdir -p $OPT $DB
    echo "downloading the package index (about 10 MB)"
    $B wget -q -O /tmp/Packages.xz "$INDEX_URL" || die "cannot download the index (network?)"
    echo "building the local index (a minute or two)"
    $B xzcat /tmp/Packages.xz | $B awk '
        function flush(   d, n, i, p, o, first) {
            if (name != "") {
                d = dep; n = split(d, parts, ","); o = ""
                for (i = 1; i <= n; i++) {
                    p = parts[i]; sub(/\|.*/, "", p); sub(/\(.*/, "", p); sub(/:.*/, "", p); gsub(/[ \t]/, "", p)
                    if (p != "") o = o " " p
                }
                print name "|" ver "|" file "|" sha "|" o "|" size "|" desc
            }
            name = ""; dep = ""; ver = ""; file = ""; sha = ""; size = ""; desc = ""
        }
        /^Package: /{ flush(); name = substr($0, 10) }
        /^Version: /{ ver = substr($0, 10) }
        /^Depends: /{ dep = substr($0, 10) }
        /^Pre-Depends: /{ dep = (dep == "" ? "" : dep ", ") substr($0, 14) }
        /^Filename: /{ file = substr($0, 11) }
        /^SHA256: /{ sha = substr($0, 9) }
        /^Size: /{ size = substr($0, 7) }
        /^Description: /{ desc = substr($0, 14) }
        END { flush() }' > $IDX.new || { $B rm -f $IDX.new /tmp/Packages.xz; die "indexing failed"; }
    $B mv $IDX.new $IDX; $B rm -f /tmp/Packages.xz
    echo "index ready: $($B wc -l < $IDX) packages"
}

cmd_search() {
    [ -f $IDX ] || die "no index yet: run  thos-pkg update"
    $B grep -i -- "$1" $IDX | $B awk -F'|' '{ print $1 " " $2 " - " $7 }' | $B head -n 40
}

# the line of the index for a package
idx_line() { $B grep -m1 "^$1|" $IDX; }

install_one() {
    name=$1
    line=$(idx_line "$name")
    [ -n "$line" ] || { echo "thos-pkg: $name is not in the archive index"; return 1; }
    file=$(echo "$line" | $B cut -d'|' -f3); sha=$(echo "$line" | $B cut -d'|' -f4); size=$(echo "$line" | $B cut -d'|' -f6)
    echo "  $name ($((size / 1024)) kB)"
    $B wget -q -O /tmp/pkg-$$.deb "$MIRROR/$file" || { $B rm -f /tmp/pkg-$$.deb; echo "thos-pkg: download of $name failed"; return 1; }
    got=$($B sha256sum /tmp/pkg-$$.deb | $B cut -d' ' -f1)
    if [ "$got" != "$sha" ]; then $B rm -f /tmp/pkg-$$.deb; echo "thos-pkg: checksum of $name does not match the index"; return 1; fi
    $B mkdir -p $ROOT $DB
    $B dpkg-deb -c /tmp/pkg-$$.deb | $B awk '{ print $NF }' | $B sed 's|^\./||' > $DB/$name.list
    $B dpkg-deb -x /tmp/pkg-$$.deb $ROOT
    $B rm -f /tmp/pkg-$$.deb
}

cmd_install_repo() {
    [ -f $IDX ] || die "no index yet: run  thos-pkg update"
    todo=$1; seen=" "
    while [ -n "$todo" ]; do
        set -- $todo; cur=$1; shift; todo="$*"
        case "$seen" in *" $cur "*) continue ;; esac
        seen="$seen$cur "
        case "$SKIP" in *" $cur "*) continue ;; esac
        [ -f $DB/$cur.list ] && continue
        line=$(idx_line "$cur")
        if [ -z "$line" ]; then echo "thos-pkg: $cur is not in the archive index"; [ "$cur" = "$FIRST" ] && return 1; continue; fi
        deps=$(echo "$line" | $B cut -d'|' -f5)
        install_one "$cur" || return 1
        todo="$todo $deps"
    done
    echo "installed $FIRST (programs are in /opt/root/usr/bin, /opt/root/bin; they are on PATH after the next login)"
}

cmd_installed() { for f in $DB/*.list; do [ -f "$f" ] && { n=${f##*/}; echo "${n%.list}"; }; done; }

cmd_list() {
    for d in $OPT/*; do [ -d "$d" ] && echo "${d##*/}"; done
}

# remove a package that came from the archive: delete its files unless another installed package lists them too
remove_archive() {
    name=$1
    other=$($B ls $DB/*.list 2>/dev/null | $B grep -v "/$name.list$")
    if [ -n "$other" ]; then
        $B cat $other | $B sort -u > /tmp/pkg-keep.$$
        $B grep -vxFf /tmp/pkg-keep.$$ $DB/$name.list > /tmp/pkg-del.$$
        $B rm -f /tmp/pkg-keep.$$
    else
        $B cp $DB/$name.list /tmp/pkg-del.$$
    fi
    # files first (longest paths first so directories empty out), then empty directories
    $B sort -r /tmp/pkg-del.$$ | while read -r f; do
        [ -n "$f" ] || continue
        if [ -d "$ROOT/$f" ] && [ ! -L "$ROOT/$f" ]; then $B rmdir "$ROOT/$f" 2>/dev/null; else $B rm -f "$ROOT/$f"; fi
    done
    $B rm -f /tmp/pkg-del.$$ $DB/$name.list
    echo "removed $name"
}

cmd_remove() {
    name=$1
    if [ -n "$name" ] && [ -f "$DB/$name.list" ]; then remove_archive "$name"; return; fi
    [ -n "$name" ] && [ -d "$OPT/$name" ] || die "not installed: $name"
    $B rm -rf "$OPT/$name"
    for f in $APPS /tmp/panel.conf /tmp/desktop.conf; do
        [ -f "$f" ] || continue
        $B grep -v "$OPT/$name/" "$f" > $f.new
        $B mv $f.new $f
    done
    echo "removed $name"
}

case "$1" in
    install) shift; cmd_install "$@" ;;
    list) cmd_list ;;
    update) cmd_update ;;
    search) shift; cmd_search "$1" ;;
    installed) cmd_installed ;;
    remove) shift; cmd_remove "$@" ;;
    *) echo "usage: thos-pkg install <file-or-url> [name] | list | remove <name>"; exit 1 ;;
esac
